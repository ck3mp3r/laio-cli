{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "command": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["command"]
    },
    "pane": {
      "type": "object",
      "properties": {
        "flex": {
          "type": "number"
        },
        "path": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/command"
          }
        },
        "style": {
          "type": "string"
        },
        "zoom": {
          "type": "boolean"
        },
        "focus": {
          "type": "boolean"
        },
        "flex_direction": {
          "type": "string",
          "enum": ["row", "column"]
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pane"
          }
        },
        "name": {
          "type": "string"
        },
        "script": {
          "type": "string"
        }
      }
    },
    "window": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "flex_direction": {
          "type": "string",
          "enum": ["row", "column"]
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pane"
          }
        },
        "focus": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["name"]
    }
  },
  "properties": {
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "startup": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "shutdown": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/window"
      }
    },
    "startup_script": {
      "type": "string"
    },
    "shutdown_script": {
      "type": "string"
    },
    "shell": {
      "type": "string"
    },
    "pane_cmd_delay": {
      "type": "integer",
      "minimum": 0
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      },
      "description": "Alias for startup; do not combine with startup in one document"
    }
  },
  "required": ["name", "windows"]
}
